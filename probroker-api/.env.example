# ---- MongoDB (same DB/collections as the old Python app — no migration needed) ----
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=test_database
# ^ IMPORTANT: this is the real production database name for the PRObroker Atlas cluster
# (all the actual listings/areas/societies live here, not in a db called "probroker" despite
# the name — verify with `db.adminCommand('listDatabases')` before changing this).
# Set to false only for local/self-hosted MongoDB without TLS. Leave true (default) for Atlas.
MONGO_TLS=true

# ---- Server ----
PORT=8000
# Use production on the server.
NODE_ENV=development
# Comma-separated list of allowed origins for the Next.js frontend(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Auth ----
# Used to sign JWTs for both admin sessions and OTP user sessions (replaces FastAPI SessionMiddleware's SECRET_KEY)
# Required. Generate with: openssl rand -hex 32. The API will not start if it is missing, short or a known example.
SECRET_KEY=
# Admin panel login is by mobile OTP only. Comma-separated 10-digit numbers allowed in.
ADMIN_PHONES=9876543210,9123456789
JWT_EXPIRES_IN=7d
# Set to true on the server so login cookies are only sent over HTTPS.
COOKIE_SECURE=false
# Optional. Production defaults to .prbroker.in so the site and API share login cookies.
COOKIE_DOMAIN=
# Paid "Get Contact" with credits. Keep false to show only the inquiry form.
CONTACT_CREDITS_ENABLED=false

# ---- Cloudflare R2 (S3-compatible) storage ----
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- 2Factor.in SMS OTP ----
# Without a valid key no SMS is sent and OTP requests return an error.
# Local development only: true shows the OTP on screen when SMS fails. Ignored when NODE_ENV=production.
OTP_DEV_MODE=false
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_API_KEY=your-2factor-api-key
# Name of the approved SMS template in the 2Factor dashboard
LOGIN_OTP_SMS_TEMPLATE=PRbroker Login OTP

# ---- Webhook and site refresh ----
# Optional. Leave empty to turn the feature off, otherwise use: openssl rand -hex 32
WEBHOOK_AUTH_KEY=
SITE_URL=https://prbroker.in
# Must be the same value as REVALIDATE_SECRET in the web app.
REVALIDATE_SECRET=
