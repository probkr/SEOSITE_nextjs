# ---- MongoDB (same DB/collections as the old Python app — no migration needed) ----
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=probroker
# Set to false only for local/self-hosted MongoDB without TLS. Leave true (default) for Atlas.
MONGO_TLS=true

# ---- Server ----
PORT=8000
NODE_ENV=development
# Comma-separated list of allowed origins for the Next.js frontend(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Auth ----
# Used to sign JWTs for both admin sessions and OTP user sessions (replaces FastAPI SessionMiddleware's SECRET_KEY)
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_EXPIRES_IN=7d

# ---- Cloudflare R2 (S3-compatible) storage ----
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=probroker
R2_PUBLIC_URL=https://media.example.com

# ---- 2Factor.in SMS OTP ----
# If left blank or set to a placeholder value, the API falls back to "dev mode"
# and returns the OTP directly in the API response (see services/smsService.js)
TWOFACT